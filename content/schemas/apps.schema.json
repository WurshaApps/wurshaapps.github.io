{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wurshaapps.github.io/schemas/apps.schema.json",
    "title": "Apps catalog",
    "description": "Language-agnostic catalog of the Mushaf apps, in display order. Pairs with `editions.list` in each content/<lang>.json by `id`.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "version",
        "apps"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "version": {
            "type": "string",
            "description": "Latest desktop release version, shown in the download section.",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "apps": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/app"
            }
        }
    },
    "$defs": {
        "app": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "id",
                "accent",
                "urls"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "enum": [
                        "madina",
                        "tajweed",
                        "warsh",
                        "qalon",
                        "shamarli"
                    ],
                    "description": "Stable id. Key in each locale's `editions.list`; also the page image /public/editions/<id>.webp."
                },
                "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Edition colour (same as its store art): card panel behind the page image."
                },
                "release": {
                    "type": "string",
                    "description": "Tag prefix in WurshaApps/QuranHolder_Releases (`<release>-v<version>`). Omit for editions without desktop builds; scripts/update-links.mjs skips them."
                },
                "urls": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Store / direct-download URLs. A missing platform shows as \"Not available\" in the download table.",
                    "properties": {
                        "android": {
                            "type": "string",
                            "format": "uri"
                        },
                        "ios": {
                            "type": "string",
                            "format": "uri"
                        },
                        "windows": {
                            "type": "string",
                            "format": "uri"
                        },
                        "mac": {
                            "type": "string",
                            "format": "uri"
                        }
                    }
                }
            }
        }
    }
}
