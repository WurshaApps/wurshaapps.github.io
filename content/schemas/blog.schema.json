{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wursha.com/schemas/blog.schema.json",
    "title": "Blog posts",
    "description": "Release announcements at /<lang>/blog/, newest first. Each post has English and Arabic text; other languages show the English text with `blog.langNote` (npm run check-content).",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "posts"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "posts": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/post"
            }
        }
    },
    "$defs": {
        "post": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "slug",
                "version",
                "date",
                "text"
            ],
            "properties": {
                "slug": {
                    "type": "string",
                    "description": "URL segment: /<lang>/blog/<slug>/. No dots (the dev server treats them as files).",
                    "pattern": "^[a-z0-9-]+$"
                },
                "version": {
                    "type": "string",
                    "description": "App version the post announces, as in the app repo's CHANGELOG.md.",
                    "pattern": "^\\d+(\\.\\d+){0,2}$"
                },
                "date": {
                    "type": "string",
                    "description": "Release date, YYYY-MM-DD.",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "text": {
                    "type": "object",
                    "description": "Post text per language code; en and ar are required.",
                    "required": [
                        "en",
                        "ar"
                    ],
                    "propertyNames": {
                        "enum": ["ar", "en", "az", "bn", "de", "fa", "fr", "hi", "id", "ms", "ps", "tr", "ur", "uz"]
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/text"
                    }
                }
            }
        },
        "text": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "summary",
                "sections"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "summary": {
                    "type": "string",
                    "minLength": 1,
                    "description": "One or two sentences: shown in the post list and as the page's meta description."
                },
                "sections": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "title",
                            "items"
                        ],
                        "properties": {
                            "title": {
                                "type": "string",
                                "minLength": 1
                            },
                            "intro": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Paragraph before the list"
                            },
                            "items": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "description": "Bulleted list; empty for none"
                            }
                        }
                    }
                }
            }
        }
    }
}
