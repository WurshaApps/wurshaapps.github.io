{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wursha.com/schemas/content.schema.json",
    "title": "Locale content",
    "description": "All copy for one language of wursha.com. Every content/<lang>.json has this shape; en.json is the master (npm run check-content).",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "$schema",
        "meta",
        "brand",
        "nav",
        "hero",
        "editions",
        "story",
        "library",
        "languages",
        "account",
        "downloads",
        "footer",
        "privacy",
        "blog"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "minLength": 0
        },
        "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "description"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "description": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "description": "Page <title> and meta description (also Open Graph)."
        },
        "brand": {
            "type": "string",
            "minLength": 1,
            "description": "Name in the header logo. \"Wursha\" (Latin) except Arabic-script pages."
        },
        "nav": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "editions",
                "features",
                "library",
                "downloads",
                "blog",
                "language"
            ],
            "properties": {
                "editions": {
                    "type": "string",
                    "minLength": 1
                },
                "features": {
                    "type": "string",
                    "minLength": 1
                },
                "library": {
                    "type": "string",
                    "minLength": 1
                },
                "downloads": {
                    "type": "string",
                    "minLength": 1
                },
                "blog": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Header link to /<lang>/blog/ (also in the footer)."
                },
                "language": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "description": "Header links and the language-picker label."
        },
        "hero": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "cta",
                "ctaSecondary",
                "platforms",
                "imageAlt",
                "news"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "cta": {
                    "type": "string",
                    "minLength": 1
                },
                "ctaSecondary": {
                    "type": "string",
                    "minLength": 1
                },
                "platforms": {
                    "type": "string",
                    "minLength": 1
                },
                "imageAlt": {
                    "type": "string",
                    "minLength": 1
                },
                "news": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "label",
                        "text"
                    ],
                    "description": "Announcement above the headline, linking to the newest blog post. Update `text` when a release gets its post.",
                    "properties": {
                        "label": {
                            "type": "string",
                            "minLength": 1,
                            "description": "Badge, e.g. New"
                        },
                        "text": {
                            "type": "string",
                            "minLength": 1,
                            "description": "One line on the release"
                        }
                    }
                }
            },
            "description": "First screen. `title` marks the gold phrase with *…*."
        },
        "editions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "platformsAll",
                "platformsMobile",
                "list"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "platformsAll": {
                    "type": "string",
                    "minLength": 1
                },
                "platformsMobile": {
                    "type": "string",
                    "minLength": 1
                },
                "list": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "madina",
                        "tajweed",
                        "warsh",
                        "qalon",
                        "shamarli"
                    ],
                    "properties": {
                        "madina": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "riwaya",
                                "series",
                                "line"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "riwaya": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "series": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        },
                        "tajweed": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "riwaya",
                                "series",
                                "line"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "riwaya": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "series": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        },
                        "warsh": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "riwaya",
                                "series",
                                "line"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "riwaya": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "series": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        },
                        "qalon": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "riwaya",
                                "series",
                                "line"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "riwaya": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "series": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        },
                        "shamarli": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                                "name",
                                "riwaya",
                                "series",
                                "line"
                            ],
                            "properties": {
                                "name": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "riwaya": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "series": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "line": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        }
                    }
                }
            },
            "description": "\"Choose your Mushaf\" cards. `list` is keyed by the ids in apps.json."
        },
        "story": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "screensNote",
                "scenes"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "screensNote": {
                    "type": "string",
                    "minLength": 0
                },
                "scenes": {
                    "type": "array",
                    "minItems": 7,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "id",
                            "title",
                            "subtitle",
                            "items"
                        ],
                        "properties": {
                            "id": {
                                "enum": [
                                    "meaning",
                                    "tartil",
                                    "memorize",
                                    "night",
                                    "tracks",
                                    "athkar",
                                    "share"
                                ]
                            },
                            "title": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Caption title; *…* marks the highlighted phrase."
                            },
                            "subtitle": {
                                "type": "string",
                                "minLength": 1
                            },
                            "items": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "note": {
                                "type": "string",
                                "minLength": 1,
                                "description": "Optional honest caveat under the bullets."
                            }
                        }
                    },
                    "maxItems": 7
                }
            },
            "description": "Feature scenes in the App Store screenshot order. `screensNote` explains which UI language the screenshots show (empty in en/ar)."
        },
        "library": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "more",
                "groups"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "more": {
                    "type": "string",
                    "minLength": 1
                },
                "groups": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "title",
                            "items"
                        ],
                        "properties": {
                            "title": {
                                "type": "string",
                                "minLength": 1
                            },
                            "items": {
                                "type": "array",
                                "minItems": 1,
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            }
                        }
                    }
                }
            },
            "description": "Four lists of book names; `more` ends each list."
        },
        "languages": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "note"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "note": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "description": "Language section; the 14 names come from src/app/i18n/locales.ts."
        },
        "account": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "items",
                "delete"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "items": {
                    "type": "array",
                    "minItems": 4,
                    "maxItems": 4,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "delete": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Link text to /delete-account"
                }
            },
            "description": "Optional account section on the home page: sign-in providers, what syncs, what data the app receives and why, deletion. The privacy link reuses footer.privacy."
        },
        "downloads": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "version",
                "columns",
                "links",
                "notAvailable",
                "winNote",
                "macNote"
            ],
            "properties": {
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "columns": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "edition",
                        "ios",
                        "android",
                        "mac",
                        "windows"
                    ],
                    "properties": {
                        "edition": {
                            "type": "string",
                            "minLength": 1
                        },
                        "ios": {
                            "type": "string",
                            "minLength": 1
                        },
                        "android": {
                            "type": "string",
                            "minLength": 1
                        },
                        "mac": {
                            "type": "string",
                            "minLength": 1
                        },
                        "windows": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "links": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                        "ios",
                        "android",
                        "mac",
                        "windows"
                    ],
                    "properties": {
                        "ios": {
                            "type": "string",
                            "minLength": 1
                        },
                        "android": {
                            "type": "string",
                            "minLength": 1
                        },
                        "mac": {
                            "type": "string",
                            "minLength": 1
                        },
                        "windows": {
                            "type": "string",
                            "minLength": 1
                        }
                    }
                },
                "notAvailable": {
                    "type": "string",
                    "minLength": 1
                },
                "winNote": {
                    "type": "string",
                    "minLength": 1
                },
                "macNote": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "description": "Edition × platform table; links come from apps.json."
        },
        "footer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "about",
                "creditsTitle",
                "credits",
                "sourcesTitle",
                "sources",
                "rights",
                "privacy"
            ],
            "properties": {
                "about": {
                    "type": "string",
                    "minLength": 1
                },
                "creditsTitle": {
                    "type": "string",
                    "minLength": 1
                },
                "credits": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "label",
                            "value"
                        ],
                        "properties": {
                            "label": {
                                "type": "string",
                                "minLength": 1
                            },
                            "value": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                "sourcesTitle": {
                    "type": "string",
                    "minLength": 1
                },
                "sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "rights": {
                    "type": "string",
                    "minLength": 1
                },
                "privacy": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Footer link text to the privacy policy page"
                }
            },
            "description": "About line, credits and data sources."
        },
        "privacy": {
            "description": "The privacy policy page, /<lang>/privacy/. URLs and email addresses in the text are turned into links.",
            "type": "object",
            "additionalProperties": false,
            "required": [
                "metaTitle",
                "metaDescription",
                "title",
                "updated",
                "intro",
                "sections"
            ],
            "properties": {
                "metaTitle": {
                    "type": "string",
                    "minLength": 1
                },
                "metaDescription": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "updated": {
                    "type": "string",
                    "minLength": 1,
                    "description": "«Last updated: <date>», in the page language"
                },
                "intro": {
                    "type": "string",
                    "minLength": 1
                },
                "sections": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                            "title",
                            "paragraphs",
                            "items"
                        ],
                        "properties": {
                            "title": {
                                "type": "string",
                                "minLength": 1
                            },
                            "paragraphs": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                }
                            },
                            "items": {
                                "type": "array",
                                "items": {
                                    "type": "string",
                                    "minLength": 1
                                },
                                "description": "Bulleted list after the paragraphs; empty for none"
                            }
                        }
                    }
                }
            }
        },
        "blog": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "metaTitle",
                "metaDescription",
                "title",
                "subtitle",
                "readMore",
                "all",
                "langNote"
            ],
            "properties": {
                "metaTitle": {
                    "type": "string",
                    "minLength": 1
                },
                "metaDescription": {
                    "type": "string",
                    "minLength": 1
                },
                "title": {
                    "type": "string",
                    "minLength": 1
                },
                "subtitle": {
                    "type": "string",
                    "minLength": 1
                },
                "readMore": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Link from a post in the list to the post"
                },
                "all": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Link from a post back to the list"
                },
                "langNote": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Shown on a post that has no text in this language, above the English text"
                }
            },
            "description": "The blog, /<lang>/blog/ and /<lang>/blog/<slug>/: page head, list heading and link labels. Posts are in content/blog.json."
        }
    }
}
