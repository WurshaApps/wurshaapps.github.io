{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://wurshaapps.github.io/schemas/content.schema.json",
    "title": "Site content (per locale)",
    "description": "All copy and structured data for the marketing site, in a single locale. The website's TypeScript `Dict` type mirrors this shape.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "meta",
        "nav",
        "hero",
        "stats",
        "audiences",
        "features",
        "editions",
        "reciters",
        "books",
        "sciences",
        "gestures",
        "downloads",
        "tech",
        "footer",
        "common",
        "apps"
    ],
    "properties": {
        "$schema": { "type": "string" },

        "meta": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "description"],
            "properties": {
                "title": { "type": "string", "description": "<title> tag and OG title." },
                "description": { "type": "string", "description": "Meta description." }
            }
        },

        "nav": {
            "type": "object",
            "additionalProperties": false,
            "required": ["features", "editions", "reciters", "books", "downloads", "switchLang"],
            "properties": {
                "features": { "type": "string" },
                "editions": { "type": "string" },
                "reciters": { "type": "string" },
                "books": { "type": "string" },
                "downloads": { "type": "string" },
                "switchLang": {
                    "type": "string",
                    "description": "Label shown on the language toggle. Should be the OTHER language's name."
                }
            }
        },

        "hero": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "eyebrow",
                "title",
                "titleHighlight",
                "subtitle",
                "ctaPrimary",
                "ctaSecondary",
                "screenshotAlt"
            ],
            "properties": {
                "eyebrow": { "type": "string", "description": "Small chip above the H1 (also used as nav brand text)." },
                "title": { "type": "string" },
                "titleHighlight": { "type": "string", "description": "Second line of the hero title, rendered with the gradient highlight." },
                "subtitle": { "type": "string" },
                "ctaPrimary": { "type": "string" },
                "ctaSecondary": { "type": "string" },
                "screenshotAlt": { "type": "string" }
            }
        },

        "stats": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "editions",
                "editionsLabel",
                "reciters",
                "recitersLabel",
                "books",
                "booksLabel",
                "features",
                "featuresLabel"
            ],
            "properties": {
                "editions": { "type": "string", "description": "Big number, e.g. '15'. String — preserves Arabic digits & '+' prefixes." },
                "editionsLabel": { "type": "string" },
                "reciters": { "type": "string" },
                "recitersLabel": { "type": "string" },
                "books": { "type": "string" },
                "booksLabel": { "type": "string" },
                "features": { "type": "string" },
                "featuresLabel": { "type": "string" }
            }
        },

        "audiences": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "items"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "items": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Audience persona cards. Currently designed for 4 items (4-col layout on wide screens).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["title", "body"],
                        "properties": {
                            "title": { "type": "string" },
                            "body": { "type": "string" }
                        }
                    }
                }
            }
        },

        "features": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "categories"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "categories": {
                    "type": "array",
                    "minItems": 1,
                    "description": "Each category renders as a feature card. The `id` selects the icon in feature.component.ts.",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["id", "title", "count", "blurb", "highlights"],
                        "properties": {
                            "id": {
                                "type": "string",
                                "description": "Stable identifier. Must match an icon mapping in feature.component.ts (reading, navigation, tracks, bookmarks, audio, search, sciences, customization, tools, gestures, editions)."
                            },
                            "title": { "type": "string" },
                            "count": {
                                "type": "integer",
                                "minimum": 0,
                                "description": "Number of features in this category. Shown as a pill on the card."
                            },
                            "blurb": { "type": "string" },
                            "highlights": {
                                "type": "array",
                                "items": { "type": "string" },
                                "description": "Bulleted list of representative features."
                            }
                        }
                    }
                }
            }
        },

        "editions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "collections", "list", "crossNote"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "collections": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "description", "items"],
                        "properties": {
                            "name": { "type": "string" },
                            "description": { "type": "string" },
                            "items": { "type": "array", "items": { "type": "string" } }
                        }
                    }
                },
                "list": {
                    "type": "array",
                    "description": "One card per edition. `code` may match a thumbnail in editions.component.ts (Madina, Shmrly, Tjwid, Warsh, Qalon).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["code", "name", "note"],
                        "properties": {
                            "code": { "type": "string" },
                            "name": { "type": "string" },
                            "note": { "type": "string" },
                            "isDefault": { "type": "boolean" }
                        }
                    }
                },
                "crossNote": { "type": "string" }
            }
        },

        "reciters": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "riwayatTitle",
                "riwayat",
                "sourcesTitle",
                "sources",
                "featuredTitle",
                "featured",
                "downloadNote"
            ],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "riwayatTitle": { "type": "string" },
                "riwayat": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name"],
                        "properties": {
                            "name": { "type": "string" },
                            "sub": { "type": "string" }
                        }
                    }
                },
                "sourcesTitle": { "type": "string" },
                "sources": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "sub"],
                        "properties": {
                            "name": { "type": "string" },
                            "sub": { "type": "string" }
                        }
                    }
                },
                "featuredTitle": { "type": "string" },
                "featured": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["name", "riwaya", "version"],
                        "properties": {
                            "name": { "type": "string" },
                            "riwaya": { "type": "string" },
                            "version": { "type": "string" }
                        }
                    }
                },
                "downloadNote": { "type": "string" }
            }
        },

        "books": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "categories"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "categories": {
                    "type": "array",
                    "description": "Tabs — `key` identifies the tab (must be unique per locale).",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["key", "title", "count", "samples"],
                        "properties": {
                            "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
                            "title": { "type": "string" },
                            "count": { "type": "string", "description": "Display count, e.g. '17 works'." },
                            "samples": { "type": "array", "items": { "type": "string" } }
                        }
                    }
                }
            }
        },

        "sciences": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "items"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "items": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["title", "body"],
                        "properties": {
                            "title": { "type": "string" },
                            "body": { "type": "string" }
                        }
                    }
                }
            }
        },

        "gestures": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "items"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "items": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["gesture", "action"],
                        "properties": {
                            "gesture": { "type": "string" },
                            "action": { "type": "string" }
                        }
                    }
                }
            }
        },

        "downloads": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "title",
                "subtitle",
                "eyebrow",
                "supportedOn",
                "platformNames",
                "platforms",
                "storeLabels",
                "primaryCta",
                "winNote",
                "macNote",
                "webSoon"
            ],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "eyebrow": { "type": "string", "description": "Small label before the version pill, e.g. 'Latest release'. Version number itself comes from apps.json." },
                "supportedOn": { "type": "string" },
                "platformNames": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["android", "ios", "windows", "mac", "web"],
                    "properties": {
                        "android": { "type": "string" },
                        "ios": { "type": "string" },
                        "windows": { "type": "string" },
                        "mac": { "type": "string" },
                        "web": { "type": "string" }
                    }
                },
                "platforms": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "ARIA labels for each store link.",
                    "required": ["android", "ios", "windows", "mac"],
                    "properties": {
                        "android": { "type": "string" },
                        "ios": { "type": "string" },
                        "windows": { "type": "string" },
                        "mac": { "type": "string" }
                    }
                },
                "storeLabels": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Two-line labels inside store pills (small line + big line).",
                    "required": ["android", "ios", "windows", "mac"],
                    "properties": {
                        "android": { "$ref": "#/$defs/storeLabel" },
                        "ios": { "$ref": "#/$defs/storeLabel" },
                        "windows": { "$ref": "#/$defs/storeLabel" },
                        "mac": { "$ref": "#/$defs/storeLabel" }
                    }
                },
                "primaryCta": { "type": "string" },
                "winNote": { "type": "string" },
                "macNote": { "type": "string" },
                "webSoon": { "type": "string" }
            }
        },

        "tech": {
            "type": "object",
            "additionalProperties": false,
            "required": ["title", "subtitle", "bullets"],
            "properties": {
                "title": { "type": "string" },
                "subtitle": { "type": "string" },
                "bullets": { "type": "array", "items": { "type": "string" } }
            }
        },

        "footer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["about", "creditsTitle", "credits", "sourcesTitle", "sources", "rights"],
            "properties": {
                "about": { "type": "string" },
                "creditsTitle": { "type": "string" },
                "credits": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": ["label", "value"],
                        "properties": {
                            "label": { "type": "string" },
                            "value": { "type": "string" }
                        }
                    }
                },
                "sourcesTitle": { "type": "string" },
                "sources": { "type": "array", "items": { "type": "string" } },
                "rights": { "type": "string" }
            }
        },

        "common": {
            "type": "object",
            "additionalProperties": false,
            "required": ["placeholder", "screenshot", "comingSoon"],
            "properties": {
                "placeholder": { "type": "string" },
                "screenshot": { "type": "string" },
                "comingSoon": { "type": "string" }
            }
        },

        "apps": {
            "type": "object",
            "description": "Per-app localized name + description, keyed by the same `id` used in apps.json.",
            "additionalProperties": false,
            "patternProperties": {
                "^[a-z][a-z0-9-]*$": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name"],
                    "properties": {
                        "name": { "type": "string" },
                        "description": { "type": "string" }
                    }
                }
            }
        }
    },

    "$defs": {
        "storeLabel": {
            "type": "object",
            "additionalProperties": false,
            "required": ["small", "big"],
            "properties": {
                "small": { "type": "string", "description": "Small line (e.g. 'GET IT ON')." },
                "big": { "type": "string", "description": "Big line (e.g. 'Google Play')." }
            }
        }
    }
}
